{
  "name": "experimental_ecommerce_app",
  "version": "1.0.0",
  "description": "Experimental ecommerce application",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "backend",
    "database",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "start:backend": "npm run start --workspace=backend",
    "start:database": "npm run start --workspace=database",
    "start:frontend": "npm run start --workspace=frontend",
    "start:all": "npm-run-all --parallel start:*",
    "test:all": "npm test --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercngiz/ecommerce_exp.git"
  },
  "author": "Ömer Cengiz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omercngiz/ecommerce_exp/issues"
  },
  "homepage": "https://github.com/omercngiz/ecommerce_exp#readme",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
